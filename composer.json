{
    "name": "componenta/auth-token",
    "description": "Purpose-separated one-time bearer tokens for Componenta authentication flows",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/identity": "^1.0.1",
        "cycle/database": "^2.22",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "componenta/clock": "^1.1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Auth\\Token\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Auth\\Token\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "stable"
}
